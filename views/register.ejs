<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link width="" rel="shortcut icon" href="/images/logoSolo.png" />

	<title> Mercado Libros Argentina</title>
	<!-- Font Awesome Stylesheet -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css">
	<!-- Bootstrap Grid Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/style.css">
	<!-- Own Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/bootstrap-grid.min.css">
</head>

<body>
	<!-- Header -->
	<%- include('./partials/header') %>
	<!-- /Header -->
	<!-- Novedades -->
	<div class="container products-wrapper">
		<div class="row">
			<div class="col-12">
				<h2 class="products-title">Registrate</h2>
			</div>
			<!-- Show the "ultimos" products -->
			<h2 class="col-12">
				<form action="/users/register" method="POST" class="productForm">
					<input type="text" name="usuario" placeholder="Usuario" value="<%= locals.old !== undefined && old.usuario ? old.usuario : ""  %>">
					<% if (locals.errors && errors.usuario) { %>
							<p class = "feedback"><%= errors.usuario.msg %></p>
					<% } %>
					<input type="email" name="email" placeholder="Email" value="<%= locals.old !== undefined && old.email ? old.email : ""  %>">
					<% if (locals.errors && errors.email) { %>
							<p class = "feedback"><%= errors.email.msg %></p>
					<% } %>
					<input type="password" name="password" placeholder="Contraseña" value="<%= locals.old !== undefined && old.password ? old.password : ""  %>">
					<% if (locals.errors && errors.password) { %>
							<p class = "feedback"><%= errors.password.msg %></p>
					<% } %>
					<button type="submit">Registrarse</button>
				</form>


	<!-- Footer -->
	<%- include('./partials/footer') %>
	<!-- /Footer -->
</body>

</html>
