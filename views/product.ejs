<!DOCTYPE html>
<html lang="es">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link width="" rel="shortcut icon" href="/images/logoSolo.png" />

	<title> Mercado Libros Argentina</title>
	<!-- Font Awesome Stylesheet -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css">
	<!-- Bootstrap Grid Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/style.css">
	<!-- Own Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/bootstrap-grid.min.css">
</head>

<body>
	<!-- Header -->
	<%- include('./partials/header') %>
	<!-- /Header -->

	<!-- Detalle del producto -->
		<div class="container products-wrapper">
			<div class="d-flex align-items-center">
				<h2 class="products-title"> <%= product.nombre %></h2>
			</div>

			<div class="product-detail">
				<div class="row">
					<!-- Información del producto -->
					<article class="col-12 col-lg-8 product-detail-info">
						<img src="<%= product.imagen %>" alt="<%= product.nombre %>" class="product-detail-img">
						<h1 class="product-detail-title">
							<%= product.nombre %>
						</h1>
						<p class="product-detail-price">
							$ <%= product.precio %>
						</p>
						<p class="product-detail-description">
							<%= product.descripcion %>
						</p>
						<p class="product-detail-description">
							Publicado por <strong>
								<a href="/users/profile/<%= product.usuario.id %>"><%= product.usuario.usuario %></a>
							</strong>
						</p>

						<!-- Vamos a editar y eliminar solamente si el producto pertenece al usuario -->
						<% if (locals.user != undefined && product.userId == user.id) { %>
							<a href="/product/edit/<%= product.id %>" class="action-button edit">Editar producto</a>
							<form action="/product/delete/<%= product.id %>" method="POST">
								<button type="submit" class="action-button delete">Eliminar producto</button>
							</form>
						<% } %>
					</article>

					<!-- Comentarios del producto -->
					<div class="col-12 col-lg-4">
						<section class="comments">
							<h3 class="comments-title">Comentarios</h3>
							<% if (product.comentarios.length == 0) { %>
								<p>Todavía no hay comentarios para este producto.</p>
							<% } else { %>
								<% for (let i=0; i < product.comentarios.length; i++) { %>
									<article>
										<img class="foto-perfil" src="<%= product.comentarios[i].usuario.fotoPerfil %>"
										alt="<%= product.comentarios[i].usuario.usuario %>">
									<div class="data">
										<p class="user">
											<strong>
												<a href="/users/profile/<%= product.comentarios[i].usuario.id %>">
													<%= product.comentarios[i].usuario.usuario %>
												</a>
											</strong>
											<span>
												<%= product.comentarios[i].comentario %>
											</span>
										</p>
									</div>
								</article>
							<% } %>
						<% } %>
					</section>

					<!-- Formulario para agregar comentarios, solo si el usuario está logueado -->
					<% if (locals.user != undefined){ %>
						<form class="form" action="/comment/agregarComentario/<%= product.id %>" method="POST">
							<input class="form-input" type="text" name="comentario" placeholder="Agregar comentario">
							<button type="submit" class="buy-now-button">Agregar comentario</button>
						</form>
					<% } %>
					<hr>
				</div>
			</div>
		</div>
	</div>
	<!-- cierro detalle del producto -->

	<!-- Footer -->
	<%- include('./partials/footer') %>
	<!-- /Footer -->

</body>

</html>
