<!DOCTYPE html>
<html lang="es">
<!-- Include Head -->

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link width="" rel="shortcut icon" href="/images/logoSolo.png" />

	<title> Mercado Libros Argentina</title>
	<!-- Font Awesome Stylesheet -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.11.2/css/all.min.css">
	<!-- Bootstrap Grid Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/style.css">
	<!-- Own Stylesheet -->
	<link rel="stylesheet" href="/stylesheets/bootstrap-grid.min.css">
</head>

<body>
	<!-- Header -->
	<%- include('./partials/header') %>
	<!-- /Header -->

	<div class="container products-wrapper">
		<div class="row product-list">
			<div class="col-12">
				<h2 class="products-title">
					<%= title %>
				</h2>
			</div>
			
			<!-- Mensaje si no se encontraron productos -->
			<% if (results.length == 0) { %>
				<div class="col-12">
					<p class="no-results">No se encontraron resultados para tu búsqueda</p>
				</div>
			<% } else { %>
				<!-- Mostramos los productos encontrados -->
				<% for( let i=0; i < results.length; i++ ) { %>
					<div class="col-12 col-sm-6 col-md-4 col-lg-3 product-column">
						<section class="product-box">
							<a href="/product/detail/<%= results[i].id %>">
								<figure class="product-box_image">
									<img src="<%= results[i].imagen %>" alt="<%= results[i].nombre %>">
								</figure>
								<article class="product-box_data">
									<h2>
										<%= results[i].nombre %>
									</h2>
									<p>
										<%= results[i].descripcion %>
									</p>
									<p>
										Precio: $<%= results[i].precio %> 
									</p>
								</article>
							</a>
						</section>
						<p class="product-comments"> Publicado por: <strong>
							<a href="/users/profile/<%= results[i].usuario.id %>"><%= results[i].usuario.usuario %></a>
							</strong>
						</p>
					</div>
				<% } %>
			<% } %>
		</div>
	</div>
			
	<!-- Footer -->
	<%- include('./partials/footer') %>
	<!-- /Footer -->
	
</body>

</html>
